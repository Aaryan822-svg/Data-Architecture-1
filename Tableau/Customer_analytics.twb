      <aliases enabled='yes' />
      <column aggregation='None' datatype='integer' name='[CLV (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='2' formula='[Calculation_143270789853839360]' peg='0' size='571' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_spend]) / TOTAL(SUM([total_spend]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CLV' datatype='real' name='[Calculation_143270789853839360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[num_transactions]*[avg_transaction_value]' />
      </column>
      <column caption='Average Revenue per Visit' datatype='real' name='[Calculation_143270789854539777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_spend])/SUM([num_visits])' />
      </column>
      <column caption='Age Bins' datatype='string' name='[Calculation_143270789860675586]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [age]&lt;26 THEN &quot;18-25&quot;&#13;&#10;elseif [age]&lt;36 then &quot;26-35&quot;&#13;&#10;ELSEIF  [age]&lt;46 THEN &quot;36-45&quot;&#13;&#10;ELSEIF [age]&lt;61 then &quot;46-60&quot;&#13;&#10;ELSE &quot;60+&quot;&#13;&#10;end' />
      </column>
      <column caption='Customer Persona' datatype='string' name='[Calculation_143270789865922563]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [total_spend]&gt;=20000&#13;&#10;     and&#13;&#10;     [num_transactions]&gt;=30&#13;&#10;     then &apos;Premium Loyal&apos;&#13;&#10;&#13;&#10;ELSEIF [discount_used]&gt;=800&#13;&#10;    and&#13;&#10;    [total_spend]&lt;=9000&#13;&#10;    then &apos;Discount Hunter&apos;&#13;&#10;&#13;&#10;elseif [num_transactions]&gt;=30&#13;&#10;     then &apos;Frequent Shopper&apos;&#13;&#10;&#13;&#10;elseif [days_since_last_purchase]&gt;50&#13;&#10;     then &apos;Inactive Customer&apos;&#13;&#10;else &apos;Normal Customer&apos;&#13;&#10;END' />
      </column>
      <column caption='Reveniue Per Visit' datatype='real' name='[Calculation_143270789888364548]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_spend])/sum([num_visits])' />
      </column>
      <column caption='Customer Engagement Score' datatype='real' name='[Calculation_143270789893668869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[num_transactions]+[num_visits]+[product_categories_purchased]' />
      </column>
      <column aggregation='None' datatype='integer' name='[Customer Engagement Score (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='0' formula='[Calculation_143270789893668869]' peg='0' size='6.3' />
      </column>
      <column aggregation='None' datatype='integer' name='[Days Since Last Purchase (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='0' formula='[days_since_last_purchase]' peg='0' size='4.62' />
      </column>
