            <column caption='Customer Persona' datatype='string' name='[Calculation_143270789865922563]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [total_spend]&gt;=20000&#13;&#10;     and&#13;&#10;     [num_transactions]&gt;=30&#13;&#10;     then &apos;Premium Loyal&apos;&#13;&#10;&#13;&#10;ELSEIF [discount_used]&gt;=800&#13;&#10;    and&#13;&#10;    [total_spend]&lt;=9000&#13;&#10;    then &apos;Discount Hunter&apos;&#13;&#10;&#13;&#10;elseif [num_transactions]&gt;=30&#13;&#10;     then &apos;Frequent Shopper&apos;&#13;&#10;&#13;&#10;elseif [days_since_last_purchase]&gt;50&#13;&#10;     then &apos;Inactive Customer&apos;&#13;&#10;else &apos;Normal Customer&apos;&#13;&#10;END' />
