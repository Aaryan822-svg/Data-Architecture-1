              <calculation class='tableau' formula='if [age]&lt;26 THEN &quot;18-25&quot;&#13;&#10;elseif [age]&lt;36 then &quot;26-35&quot;&#13;&#10;ELSEIF  [age]&lt;46 THEN &quot;36-45&quot;&#13;&#10;ELSEIF [age]&lt;61 then &quot;46-60&quot;&#13;&#10;ELSE &quot;60+&quot;&#13;&#10;end' />
